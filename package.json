{
  "name": "snapstrip-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:public": "VITE_PUBLIC_BUILD=true pnpm build",
    "preview": "vite preview",
